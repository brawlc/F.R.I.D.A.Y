# GEMINI_API_KEY: Optional automatic fallback for chat when Ollama is unavailable.
# If this is present, FRIDAY uses Gemini automatically unless FRIDAY_USE_GEMINI=false.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VENICE_API_KEY: Optional OpenAI-compatible chat fallback.
# FRIDAY uses Venice automatically when configured, especially if Ollama/Gemini are unavailable.
VENICE_API_KEY="MY_VENICE_API_KEY"
VENICE_MODEL="zai-org-glm-5"

# FRIDAY_USE_GEMINI=false disables Gemini fallback even when GEMINI_API_KEY is present.
# FRIDAY_USE_GEMINI=true is no longer required.
# FRIDAY_USE_VENICE=false disables Venice fallback even when VENICE_API_KEY is present.
# FRIDAY_MODEL_ORDER controls chat priority from first to last.
FRIDAY_MODEL_ORDER="venice,gemini,ollama"

# Optional fourth fallback for Website Studio (separate OpenAI API billing).
# Add your key to backend/.env.local; never commit real keys.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Optional Kali Linux VM bridge over SSH. Keep this pointed at your local VM.
KALI_SSH_HOST="127.0.0.1"
KALI_SSH_PORT="2222"
KALI_SSH_USER="kali"
KALI_SSH_KEY="C:\Users\Admin\.ssh\friday_kali"

# GOOGLE_SEARCH_API_KEY and GOOGLE_SEARCH_ENGINE_ID: Optional.
# Enables Google Custom Search-backed research answers in /api/chat.
GOOGLE_SEARCH_API_KEY="MY_GOOGLE_SEARCH_API_KEY"
GOOGLE_SEARCH_ENGINE_ID="MY_GOOGLE_SEARCH_ENGINE_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional automatic read-only monitoring. Keep intervals reasonable because
# scans inspect local Windows/security state.
FRIDAY_AUTO_MONITOR="true"
FRIDAY_AUTO_MONITOR_INTERVAL_MS="900000"

# Reverse Engineering Intelligence Module
# Static, local artifact analysis only. Evidence is stored beneath the project in
# .friday-re by default and is excluded from source control. Do not point this
# at a shared or web-served directory.
FRIDAY_RE_STORAGE_DIR=".friday-re"
FRIDAY_RE_MAX_ARTIFACT_BYTES="8388608"
FRIDAY_RE_MAX_INSPECT_BYTES="4194304"
FRIDAY_RE_WORKER_TIMEOUT_MS="30000"
FRIDAY_RE_WORKER_MEMORY_MB="192"
# Optional scholarly research credentials. Existing Google Search settings enable web/documentation discovery.
SEMANTIC_SCHOLAR_API_KEY=

# Communications Hub: routine -> ntfy; security -> authorized private Telegram chat.
# Explicit opt-in. No inbound Telegram commands are supported.
FRIDAY_NTFY_ENABLED=false
FRIDAY_NTFY_URL=https://ntfy.sh
# Optional preferred alias; when set, SERVER takes precedence over URL.
FRIDAY_NTFY_SERVER=
FRIDAY_NTFY_TOPIC=
FRIDAY_NTFY_TOKEN=
FRIDAY_TELEGRAM_ENABLED=false
FRIDAY_TELEGRAM_BOT_TOKEN=
FRIDAY_TELEGRAM_CHAT_ID=
FRIDAY_NOTIFICATION_DEVICE=FRIDAY device
FRIDAY_DAILY_BRIEFING_ENABLED=false

# Private research reports. Never place the directory under frontend/dist/build/public.
FRIDAY_REPORTS_DIR=
FRIDAY_REPORT_RETENTION_DAYS=30
FRIDAY_REPORT_MAX_COUNT=100
# Remote PDF uploads are unencrypted: enable only for nonsensitive research.
FRIDAY_REPORT_NTFY_ENABLED=false
