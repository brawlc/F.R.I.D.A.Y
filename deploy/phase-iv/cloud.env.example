# TEMPLATE ONLY. No real hostnames or credentials. Do not commit filled copies.
FRIDAY_CLOUD_ORIGIN=
FRIDAY_CLOUD_PORT=3210
FRIDAY_CLOUD_DATA=/var/lib/friday
# Only providers explicitly approved for cloud data/usage. Empty = retrieval only.
FRIDAY_CLOUD_PROVIDERS=
# SHA-256 of a random one-time enrollment code; keep raw code outside cloud config.
FRIDAY_ENROLLMENT_SHA256=
FRIDAY_NTFY_ENABLED=true
FRIDAY_NTFY_SERVER=
FRIDAY_NTFY_TOPIC=
FRIDAY_NTFY_SECURITY_TOPIC=
FRIDAY_NTFY_TOKEN=
# Set true only after authenticated publisher/subscriber ACL checks pass.
FRIDAY_NTFY_ACL_VERIFIED=false
# Optional explicitly authorized provider credentials; never copy desktop .env wholesale.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
VENICE_API_KEY=
VENICE_MODEL=
